{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TagForge",
  "version": "1.0.0",
  "identifier": "org.tagforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TagForge",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 680,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Music metadata, thoughtfully forged.",
    "licenseFile": "../LICENSE",
    "resources": ["../THIRD_PARTY_NOTICES.md", "../docs/licenses/"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "zlib"
      }
    }
  }
}
